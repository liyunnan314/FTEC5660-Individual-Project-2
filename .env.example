# This project needs NO real credentials. The offline harness replaces the LLM
# client at runtime. These placeholders only stop upstream client constructors
# from looking for a missing environment variable.
#
# Copy to .env if you like (.env is gitignored). Never put a real key in the repo.
OPENAI_API_KEY=placeholder-not-a-real-key
DEEPSEEK_API_KEY=placeholder-not-a-real-key
ANTHROPIC_API_KEY=placeholder-not-a-real-key
GOOGLE_API_KEY=placeholder-not-a-real-key
ALPHA_VANTAGE_API_KEY=placeholder-not-a-real-key
FRED_API_KEY=placeholder-not-a-real-key

# To repeat the study with a real model, see docs/REAL_LLM_UPGRADE.md.
# For OpenAI-compatible endpoints (incl. DeepSeek):
# TRADINGAGENTS_LLM_PROVIDER=openai_compatible
# TRADINGAGENTS_LLM_BACKEND_URL=https://api.deepseek.com/v1
# TRADINGAGENTS_QUICK_THINK_LLM=deepseek-chat
# TRADINGAGENTS_DEEP_THINK_LLM=deepseek-reasoner
